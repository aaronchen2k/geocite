{
  "name": "@geocite/server",
  "private": true,
  "scripts": {
    "debug:server": "node --watch --require ts-node/register src/main.ts",
    "dev": "pnpm run debug:server",
    "build": "tsc -p tsconfig.json",
    "seed": "node --require ts-node/register src/database/seed.ts",
    "migrate:data": "node --require ts-node/register src/database/migrate-audit-data.ts",
    "simulate:diagnosis": "node --require ts-node/register src/scripts/simulate-execution-diagnosis.ts",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.3",
    "@openai/codex-sdk": "^0.148.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pino": "^10.3.1",
    "playwright-core": "^1.62.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sqlite3": "^6.0.1",
    "typeorm": "^0.3.24"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.1",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*(\\.e2e-spec|\\.spec)\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "target": "ES2022",
            "experimentalDecorators": true,
            "emitDecoratorMetadata": true,
            "esModuleInterop": true
          }
        }
      ]
    }
  }
}
